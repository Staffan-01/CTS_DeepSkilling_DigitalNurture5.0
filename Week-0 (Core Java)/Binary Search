import java.util.*;
public class Main{
    static int search(int arr[], int target) {
        int low = 0, high = arr.length - 1;
        while(low <= high) {
            int mid = (low + high) / 2;
            if(arr[mid] == target)
                return mid;
            else if(arr[mid] < target)
                low = mid + 1;
            else
                high = mid - 1;
        }
        return -1;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int arr[] = new int[n];
        for(int i = 0; i < n; arr[i++] = sc.nextInt());
        int k = sc.nextInt();
        System.out.println("Index = " + search(arr, k));
    }
}
